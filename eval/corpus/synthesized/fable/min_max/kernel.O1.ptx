	.param .b64 __illAtomicMax_param_1
)
{
	.reg .b64 	%rd<5>;


	ld.param.u64 	%rd1, [__illAtomicMax_param_0];
	ld.param.u64 	%rd2, [__illAtomicMax_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	atom.global.max.s64 	%rd4, [%rd3], %rd2;
	ret;

}
.func __ullAtomicMax(
	.param .b64 __ullAtomicMax_param_0,
	.param .b64 __ullAtomicMax_param_1
)
{
	.reg .b64 	%rd<5>;


	ld.param.u64 	%rd1, [__ullAtomicMax_param_0];
	ld.param.u64 	%rd2, [__ullAtomicMax_param_1];
	cvta.to.global.u64 	%rd3, %rd1;
	atom.global.max.u64 	%rd4, [%rd3], %rd2;
	ret;

}

